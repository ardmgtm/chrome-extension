{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "1.3.0",
  "description": "Halaman tab baru dengan aplikasi populer, situs favorit, cuaca, dan wallpaper pilihan.",
  "permissions": ["topSites", "favicon", "storage"],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://api.aladhan.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}